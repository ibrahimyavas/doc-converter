# Get a key at https://cloudconvert.com/dashboard/api/v2/keys (free tier:
# ~25 conversion minutes/day, no card required for signup).
CLOUDCONVERT_API_KEY=

# Set to "true" while testing against CloudConvert's sandbox (unlimited,
# but output files are watermarked/truncated).
CLOUDCONVERT_SANDBOX=false

# Origin(s) allowed to call this API, comma-separated. Matches the Vite
# dev server by default.
CORS_ORIGIN=http://localhost:5173

PORT=8787
