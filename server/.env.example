# Origin(s) allowed to call this API, comma-separated. Both localhost and
# 127.0.0.1 are listed because browsers treat them as different origins
# even though Vite's dev server answers to both.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

PORT=8787

# OmniRoute (github.com/diegosouzapw/OmniRoute) — self-hosted AI gateway
# used for the PDF summary/study-guide/flashcards feature. Run `omniroute`
# locally (npm install -g omniroute) and get a key from its dashboard.
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto/best-chat

# Local conversion tools — file conversion/compression is fully
# self-hosted (ffmpeg, LibreOffice, Poppler, mutool), no cloud API or key
# needed. Leave these unset if the tools are already on PATH (the normal
# case in Docker / most Linux setups, e.g. `apt install ffmpeg libreoffice
# poppler-utils mupdf-tools`); set them to absolute paths only if a tool
# isn't discoverable on PATH.
# FFMPEG_PATH=
# SOFFICE_PATH=
# PDFTOPPM_PATH=
# PDFTOTEXT_PATH=
# MUTOOL_PATH=
